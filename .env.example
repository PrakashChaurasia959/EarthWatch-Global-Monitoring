# ============================================================
# EarthWatch environment variables
# Copy this file to ".env" and fill in the values you need.
# Only VITE_-prefixed variables are exposed to the browser bundle.
# Never place true secrets in VITE_ variables.
# ============================================================

# NASA API key for the Astronomy Picture of the Day (APOD) and other
# planetary.nasa.gov endpoints. The shared DEMO_KEY works but is heavily
# rate-limited (30 requests / hour / IP, 50 / day). Get a free key at:
# https://api.nasa.gov/
# OPTIONAL. The app falls back to DEMO_KEY and keeps working.
VITE_NASA_API_KEY=DEMO_KEY

# NASA FIRMS MAP_KEY for near-real-time active fire detections.
# This is a free key intended to be embedded in request URLs (it is a
# usage-tracking token, not a secret credential). Register at:
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
# OPTIONAL. When unset, the Wildfires page uses public EONET wildfire
# events and shows a setup notice for FIRMS.
VITE_FIRMS_MAP_KEY=

# Default USGS earthquake feed window. One of: hour, day, week, month
# (only affects initial load default; users can change it in the UI).
# OPTIONAL. Defaults to "day".
VITE_DEFAULT_QUAKE_WINDOW=day

# Default FIRMS detection source. One of: VIIRS_SNPP, VIIRS_NOAA20, MODIS, combined
# OPTIONAL. Defaults to "VIIRS_SNPP".
VITE_DEFAULT_FIRMS_SOURCE=VIIRS_SNPP
